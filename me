#!/bin/bash
# Convenience runner for syncing all or part of the me.sh configuration.
#
# Usage:
#   me                          List available units
#   me --help                   Show detailed help
#   me all                      Sync everything (macOS + app configs)
#   me bootstrap                Run fresh-machine setup steps in order
#   me bootstrap <name>...      Run selected bootstrap steps
#   me app | apps               Full app sync
#   me macos | sys | system     Full macOS sync
#   me [app|macos] <name>...    Sync only the named configs
#   me status [app|macos] [<name>|<path>...]
#                               List files whose deployed copy differs from the
#                               repo (compact; no diffs shown)
#   me diff [app|macos] [<name>|<path>...]
#                               Show one combined diff of drift between live
#                               materialized copies and the repo (every config
#                               when nothing is named); path args scope by file
#   me up [app|macos] [<name>|<path>...]
#                               Pick local changes to pull back into the repo
#                               (alias for the older name: absorb)
#   me add <file> [--link symlink|copy] [--app name] [--dest \$HOME/...]
#                               Adopt a file into a config unit: copy it into
#                               configs/<scope>/<unit>/, wire it into that
#                               unit's config.yml, and deploy. Prompts for
#                               anything not passed as a flag.
#   me remove [--delete|--unlink] <unit|file>...
#                               Undo an add: drop matching manifest rows and
#                               their repo sources, retire deployed copies.
#   me install                  Copy a 'me' shim into ~/bin so this runner is on PATH
#   me doctor                   Validate every declarative config and claim
#   me plan [scope] [<name>...] Validate and print actions without deploying
#   me --force ...              Move conflicting destinations aside before
#                               deploying, instead of failing the unit
set -euo pipefail

repo_root="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
cd "$repo_root" || exit 1

source "lib/common.sh"
source "lib/compose.sh"
source "lib/manifests.sh"
source "lib/add.sh"
source "lib/remove.sh"

readonly APPS_SCOPE="apps"
readonly MACOS_SCOPE="macos"
readonly BOOTSTRAP_SCOPE="bootstrap"
readonly CONFIG_SCOPE="config"
readonly ANY_SCOPE="any"

# --- Discovery -------------------------------------------------------------

# Print executable config entries for a scope, in directory order. A config.yml
# replaces every legacy configure script in its direct-child unit directory.
function list_config_units {
	local dir
	while IFS= read -r dir; do
		if [[ -f "$dir/config.yml" ]]; then
			printf '%s\n' "$dir/config.yml"
		else
			find "$dir" -type f -name 'configure_*.sh' | LC_ALL=C sort
		fi
	done < <(find "configs/$1" -mindepth 1 -maxdepth 1 -type d | LC_ALL=C sort)
}

# Print bootstrap scripts in filename order. The two-digit prefix is the
# sequence; the remainder of the filename is the public unit name.
function list_bootstrap_scripts {
	find "bootstrap" -maxdepth 1 -type f -name '[0-9][0-9]-*.sh' | sort
}

# Print the config name of a script path (configure_<name>.sh -> <name>).
function script_name {
	local base="${1##*/}"
	base="${base#configure_}"
	printf '%s' "${base%.sh}"
}

# Print the public name of a bootstrap script (10-prerequisites.sh -> prerequisites).
function bootstrap_script_name {
	local base="${1##*/}"
	base="${base#??-}"
	printf '%s' "${base%.sh}"
}

# Config directories may use the same optional ordering prefix. It affects
# execution order without leaking into the command name (00-homebrew -> homebrew).
function config_dir_name {
	local name
	name="$(basename "$(dirname "$1")")"
	case "$name" in
		[0-9][0-9]-*) name="${name#??-}" ;;
	esac
	printf '%s' "$name"
}

function is_manifest_unit {
	[[ "${1##*/}" == config.yml ]]
}

# Print every accepted config name for a scope, one per line, sorted.
# Legacy units accept directory and script aliases. Manifest units use only
# their directory-derived canonical name.
function list_names {
	local unit
	{
		while IFS= read -r unit; do
			printf '%s\n' "$(config_dir_name "$unit")"
			if ! is_manifest_unit "$unit"; then
				printf '%s\n' "$(script_name "$unit")"
			fi
		done < <(list_config_units "$1")
	} | sort -fu
}

# Emit 'scope<TAB>name' lines for zsh completion (internal use only).
function show_completion_names {
	local scope dir unit
	{
		for scope in app macos; do
			if [[ "$scope" == macos ]]; then dir="$MACOS_SCOPE"; else dir="$APPS_SCOPE"; fi
			while IFS= read -r unit; do
				printf '%s\t%s\n' "$scope" "$(config_dir_name "$unit")"
				if ! is_manifest_unit "$unit"; then
					printf '%s\t%s\n' "$scope" "$(script_name "$unit")"
				fi
			done < <(list_config_units "$dir")
		done
		while IFS= read -r script; do
			printf 'bootstrap\t%s\n' "$(bootstrap_script_name "$script")"
		done < <(list_bootstrap_scripts)
	} | sort -fu
}

# --- Resolution ------------------------------------------------------------

declare -a selected=()

# Add a script to 'selected', skipping duplicates.
function add_selected {
	local candidate="$1" existing
	if (( ${#selected[@]} > 0 )); then
		for existing in "${selected[@]}"; do
			if [[ "$existing" == "$candidate" ]]; then
				return 0
			fi
		done
	fi
	selected+=("$candidate")
}

# Raw matches from the most recent collect_matches call.
declare -a matches=()

# Fill 'matches' with every unit in a scope whose accepted name equals NAME.
function collect_matches {
	local scope="$1" name="$2" unit
	matches=()
	if [[ "$scope" == "$BOOTSTRAP_SCOPE" ]]; then
		while IFS= read -r script; do
			if [[ "$(bootstrap_script_name "$script")" == "$name" ]]; then
				matches+=("$script")
			fi
		done < <(list_bootstrap_scripts)
		return
	fi
	while IFS= read -r unit; do
		if [[ "$(config_dir_name "$unit")" == "$name" ]] || { ! is_manifest_unit "$unit" && [[ "$(script_name "$unit")" == "$name" ]]; }; then
			matches+=("$unit")
		fi
	done < <(list_config_units "$scope")
}

# Resolve one requested name against a concrete scope, config scopes, or all
# unit types. CONFIG_SCOPE deliberately excludes bootstrap for diff/up.
function resolve_name {
	local scope="$1" name="$2"
	local -a app_matches=() macos_matches=() bootstrap_matches=()
	local m match_groups=0

	if [[ "$scope" == "$APPS_SCOPE" || "$scope" == "$MACOS_SCOPE" || "$scope" == "$BOOTSTRAP_SCOPE" ]]; then
		collect_matches "$scope" "$name"
		if (( ${#matches[@]} == 0 )); then
			if [[ "$scope" == "$BOOTSTRAP_SCOPE" ]]; then
				error "No bootstrap unit named '${name}'. Available names:"
				list_bootstrap_names | sed 's/^/  /' >&2
			else
				error "No config named '${name}' found in configs/$scope. Available names:"
				list_names "$scope" | sed 's/^/  /' >&2
			fi
			exit 1
		fi
		for m in "${matches[@]}"; do
			add_selected "$m"
		done
		return
	fi

	# Search both config trees, plus bootstrap units for an unrestricted lookup.
	collect_matches "$APPS_SCOPE" "$name"
	if (( ${#matches[@]} > 0 )); then
		app_matches=("${matches[@]}")
		(( ++match_groups ))
	fi
	collect_matches "$MACOS_SCOPE" "$name"
	if (( ${#matches[@]} > 0 )); then
		macos_matches=("${matches[@]}")
		(( ++match_groups ))
	fi
	if [[ "$scope" == "$ANY_SCOPE" ]]; then
		collect_matches "$BOOTSTRAP_SCOPE" "$name"
		if (( ${#matches[@]} > 0 )); then
			bootstrap_matches=("${matches[@]}")
			(( ++match_groups ))
		fi
	fi

	if (( match_groups > 1 )); then
		error "'${name}' is ambiguous:"
		for m in ${app_matches[@]+"${app_matches[@]}"} ${macos_matches[@]+"${macos_matches[@]}"} ${bootstrap_matches[@]+"${bootstrap_matches[@]}"}; do
			error "  ${m}"
		done
		error "Re-run with an explicit scope: app, macos, or bootstrap"
		exit 1
	fi

	if (( match_groups == 0 )); then
		if [[ "$scope" == "$CONFIG_SCOPE" ]]; then
			error "No config named '${name}'. Available config names:"
			show_config_list >&2
		else
			error "No unit named '${name}'. Available names:"
			show_list >&2
		fi
		exit 1
	fi

	for m in ${app_matches[@]+"${app_matches[@]}"} ${macos_matches[@]+"${macos_matches[@]}"} ${bootstrap_matches[@]+"${bootstrap_matches[@]}"}; do
		add_selected "$m"
	done
}

# Resolve all requested names against a scope, filling 'selected'. Exits on the
# first unknown or ambiguous name.
function resolve_args {
	local scope="$1" name
	shift
	selected=()
	for name in "$@"; do
		resolve_name "$scope" "$name"
	done
}

# --- Execution -------------------------------------------------------------

declare -a failed_units=()

# Run every config unit in 'selected', collecting failures. The Homebrew unit
# is fail-fast only when it is part of a macOS aggregate.
function run_selected {
	local unit aggregate_scope="${1:-}"
	if (( ${#selected[@]} == 0 )); then
		return
	fi
	for unit in "${selected[@]}"; do
		message "Running ${unit}..."
		if is_manifest_unit "$unit"; then
			if run_manifest_unit "$repo_root/$unit"; then
				continue
			fi
		else
			if bash "$unit"; then
				# The Homebrew unit runs in a child shell. Reload its environment in
				# this process so a just-installed yq is visible to later units.
				if [[ "$aggregate_scope" == "$MACOS_SCOPE" && "$unit" == configs/macos/00-homebrew/configure_homebrew.sh ]]; then
					load_homebrew || {
						error "Homebrew was reconciled but could not be loaded into PATH"
						exit 1
					}
				fi
				continue
			fi
		fi
		if [[ "$aggregate_scope" == "$MACOS_SCOPE" && "$unit" == configs/macos/00-homebrew/configure_homebrew.sh ]]; then
			error "${unit} failed; configuration prerequisites stopped"
			exit 1
		fi
		error "${unit} failed"
		failed_units+=("$unit")
	done
}

# Bootstrap is an ordered dependency chain, so stop at the first failed step.
function run_bootstrap_selected {
	local script
	for script in "${selected[@]}"; do
		message "Running ${script}..."
		if ! bash "$script"; then
			error "${script} failed; bootstrap stopped"
			exit 1
		fi
	done
}

# Fill 'selected' with the complete ordered bootstrap sequence.
function select_bootstrap_scripts {
	local script
	selected=()
	while IFS= read -r script; do
		selected+=("$script")
	done < <(list_bootstrap_scripts)
}

# Run every configure script in a scope, collecting failures.
function run_scope {
	local scope="$1"
	select_units_in_scope "$scope"
	run_selected "$scope"
}

# Fill 'selected' with every unit in a scope.
function select_units_in_scope {
	local unit
	selected=()
	while IFS= read -r unit; do
		selected+=("$unit")
	done < <(list_config_units "$1")
}

# Fill 'selected' with every script in one scope, or both when no scope is given.
function select_drift_scripts {
	if [[ -n "$1" ]]; then
		select_units_in_scope "$1"
	else
		select_all_config_units
	fi
}

# Fill 'selected' with every config unit in macOS-then-app execution order.
function select_all_config_units {
	local unit
	selected=()
	while IFS= read -r unit; do selected+=("$unit"); done < <(list_config_units "$MACOS_SCOPE")
	while IFS= read -r unit; do selected+=("$unit"); done < <(list_config_units "$APPS_SCOPE")
}

# --- Drift: status / diff / up (absorb) ------------------------------------

# Print kind<TAB>repo-source<TAB>deployed-destination rows for every
# materialized file owned by UNIT. Managed files use marker discovery; plain
# copies come directly from a manifest's copies section.
function drift_files_under_unit {
	local unit="$1" dir src dst
	dir="$(dirname "$unit")"
	while IFS=$'\t' read -r src dst; do
		printf 'managed\t%s\t%s\n' "$src" "$dst"
	done < <(managed_files_under "$dir")
	if is_manifest_unit "$unit"; then
		while IFS=$'\t' read -r src dst; do
			printf 'copy\t%s\t%s\n' "$src" "$dst"
		done < <(manifest_copy_files_under "$repo_root/$dir")
	fi
}

declare -a drift_filters=()

# Sweep results shared by status / diff / up.
declare -a drift_src=() drift_dst=() drift_base=() drift_kind=() drift_unit=()
declare drift_scope=""
declare -a drift_undeployed_src=() drift_undeployed_dst=()
declare drift_tmp="" drift_clean_count=0

# Normalize a path filter argument: expand a leading '~' to $HOME and drop a
# trailing slash so prefix matching works cleanly.
function normalize_drift_pattern {
	local pattern="${1%/}"
	if [[ "$pattern" == "~" ]]; then
		pattern="$HOME"
	elif [[ "$pattern" == "~/"* ]]; then
		pattern="$HOME/${pattern:2}"
	fi
	printf '%s' "$pattern"
}

# True when PATTERN matches PATH on '/' boundaries: exact, directory prefix,
# or any trailing or middle run of components ('ghostty/config',
# '~/Library', 'apps/git' all match their targets).
function drift_pattern_matches_path {
	local pattern="$1" path="$2"
	[[ -z "$pattern" ]] && return 1
	[[ "$path" == "$pattern" || "$path" == "$pattern"/* || "$path" == */"$pattern" || "$path" == *"/$pattern"/* ]]
}

# A row passes when no filters are set or either side matches any filter;
# multiple filters union like positional paths in git diff.
function drift_row_matches_filters {
	local src="$1" dst="$2" pattern
	if (( ${#drift_filters[@]} == 0 )); then
		return 0
	fi
	for pattern in ${drift_filters[@]+"${drift_filters[@]}"}; do
		if drift_pattern_matches_path "$pattern" "$src" || drift_pattern_matches_path "$pattern" "$dst"; then
			return 0
		fi
	done
	return 1
}

# Resolve one drift argument: arguments containing '/' are always path filters;
# bare words resolve as config names first and fall back to path filters.
function resolve_drift_arg {
	local scope="$1" arg="$2" m app_total
	if [[ "$arg" != */* ]]; then
		if [[ "$scope" == "$APPS_SCOPE" || "$scope" == "$MACOS_SCOPE" ]]; then
			collect_matches "$scope" "$arg"
		else
			collect_matches "$APPS_SCOPE" "$arg"
			app_total=${#matches[@]}
			collect_matches "$MACOS_SCOPE" "$arg"
			if (( app_total > 0 && ${#matches[@]} > 0 )); then
				error "'$arg' is ambiguous across app and macOS configs; re-run with an explicit scope: app or macos"
				exit 1
			fi
		fi
		if (( ${#matches[@]} > 0 )); then
			for m in "${matches[@]}"; do
				add_selected "$m"
			done
			return
		fi
	fi
	drift_filters+=("$(normalize_drift_pattern "$arg")")
}

# Parse '<scope> <arg>...' for status/diff/up into 'selected' units plus
# 'drift_filters'. Path-only invocations sweep the whole given scope so the
# filters alone decide which rows survive.
function parse_drift_args {
	local scope="" arg
	selected=()
	drift_filters=()
	drift_scope=""
	if (( $# > 0 )); then
		case "$1" in
			all) select_drift_scripts ""; drift_scope="all"; return ;;
			app|apps) scope="$APPS_SCOPE"; shift ;;
			mac|macos|sys|system) scope="$MACOS_SCOPE"; shift ;;
		esac
	fi
	if (( $# == 0 )); then
		select_drift_scripts "$scope"
		drift_scope="$scope"
		return
	fi
	for arg in "$@"; do
		resolve_drift_arg "$scope" "$arg"
	done
	if (( ${#selected[@]} == 0 )); then
		select_drift_scripts "$scope"
	fi
	drift_scope="$scope"
}

# Prepare each unit's deployable baselines and fill the sweep arrays, applying
# path filters. MODE 'quiet' drops per-file chatter for 'me status'; 'verbose'
# keeps it for 'me diff' / 'me up'.
function collect_drift_files {
	local mode="${1:-verbose}" unit kind src dst baseline rc considered=0
	drift_src=()
	drift_dst=()
	drift_base=()
	drift_kind=()
	drift_unit=()
	drift_undeployed_src=()
	drift_undeployed_dst=()
	drift_clean_count=0
	drift_tmp="$(mktemp -d "${TMPDIR:-/tmp}/me-drift.XXXXXX")"
	for unit in "${selected[@]}"; do
		if is_manifest_unit "$unit" && ! validate_manifest_unit "$repo_root/$(dirname "$unit")" yes no; then
			error "$unit failed validation; skipping drift review"
			failed_units+=("$unit")
			continue
		fi
		while IFS=$'\t' read -r kind src dst; do
			drift_row_matches_filters "$src" "$dst" || continue
			(( ++considered ))
			if [[ ! -e "$dst" ]]; then
				if [[ "$mode" == verbose ]]; then
					error "Not deployed yet, skipping: $src -> $dst"
				fi
				drift_undeployed_src+=("$src")
				drift_undeployed_dst+=("$dst")
				continue
			fi
			baseline="$drift_tmp/base-${#drift_src[@]}"
			if [[ "$kind" == managed ]]; then
				# No fragments yet is fine for a managed file: compare against base.
				rc=0
				compose_file "$repo_root/$src" "$baseline" || rc=$?
				if (( rc == 2 )); then
					cp "$repo_root/$src" "$baseline"
				elif (( rc != 0 )); then
					error "Compose failed for $src; skipping drift review"
					continue
				fi
			elif ! cp "$repo_root/$src" "$baseline"; then
				error "Could not prepare copy source $src; skipping drift review"
				continue
			fi
			if cmp -s "$baseline" "$dst"; then
				(( ++drift_clean_count ))
				if [[ "$mode" == verbose ]]; then
					message "Up to date: $src"
				fi
				continue
			fi
			drift_src+=("$src")
			drift_dst+=("$dst")
			drift_base+=("$baseline")
			drift_kind+=("$kind")
			drift_unit+=("$unit")
		done < <(drift_files_under_unit "$unit")
	done
	if (( ${#drift_filters[@]} > 0 && considered == 0 )); then
		error "No deployed files match: ${drift_filters[*]}"
	fi
}

# Print a compact changed-files report instead of diffs. Read-only.
function run_status {
	collect_drift_files quiet
	local i
	if (( ${#drift_src[@]} > 0 )); then
		echo "Changed files (${#drift_src[@]}):"
		for (( i=0; i<${#drift_src[@]}; i++ )); do
			printf 'M %s -> %s\n' "${drift_src[i]}" "${drift_dst[i]}"
		done
	else
		echo "No changed files."
	fi
	if (( ${#drift_undeployed_src[@]} > 0 )); then
		echo
		echo "Not deployed (${#drift_undeployed_src[@]}):"
		for (( i=0; i<${#drift_undeployed_src[@]}; i++ )); do
			printf '? %s -> %s\n' "${drift_undeployed_src[i]}" "${drift_undeployed_dst[i]}"
		done
	fi
	echo
	echo "Clean copies: ${drift_clean_count}"
	rm -rf "$drift_tmp"
}

# Config format for fragment extraction, derived from the managed base suffix.
function absorb_format_for {
	case "$1" in
		*.yaml|*.yml) printf 'yaml' ;;
		*.toml) printf 'toml' ;;
		*) printf 'json' ;;
	esac
}

# Print the repo-relative fragment path that should receive local hunks for
# managed base SRC. Lists merge fragments (*.json/*.yaml/*.yml/*.toml) plus a
# create-new option; ABSORB_FRAGMENT skips the prompt (path or 'new').
function pick_absorb_fragment {
	local src="$1" frag
	local overlay_dir="$repo_root/${src}.d"
	local -a fragments=()
	if [[ -d "$overlay_dir" ]]; then
		while IFS= read -r frag; do
			case "$frag" in
				*.json|*.yaml|*.yml|*.toml) fragments+=("$frag") ;;
			esac
		done < <(ls "$overlay_dir" 2>/dev/null | LC_ALL=C sort)
	fi
	if [[ -n "${ABSORB_FRAGMENT:-}" ]]; then
		if [[ "$ABSORB_FRAGMENT" == new ]]; then
			: # fall through to auto-name below
		else
			printf '%s\n' "$ABSORB_FRAGMENT"
			return 0
		fi
	fi
	local i=1 existing="${fragments[*]:-}"
	local suggestion="20-local.json"
	if [[ -n "$existing" ]]; then
		local max=0 num
		for frag in "${fragments[@]}"; do
			if [[ "$frag" =~ ^([0-9]+)- ]]; then
			num="${BASH_REMATCH[1]}"
			(( num > max )) && max="$num"
			fi
		done
		printf -v suggestion "%02d-local.json" "$(( max + 10 ))"
	fi
	if [[ ! -t 0 && -z "${ABSORB_FRAGMENT:-}" ]]; then
		printf '%s\n' "${src}.d/$suggestion"
		return 0
	fi
	if (( ${#fragments[@]} > 0 )); then
		message "Local fragments for $src:"
		for (( i=0; i<${#fragments[@]}; i++ )); do
			printf '  %d) %s\n' "$(( i + 1 ))" "${fragments[i]}" >&2
		done
		printf '  n) new: %s\n' "$suggestion" >&2
	fi
	local answer
	if [[ "${ABSORB_FRAGMENT:-}" == new ]]; then
		answer=n
	else
		printf 'Fragment for local hunks [n]: ' >&2
		IFS= read -r answer </dev/tty 2>/dev/null || answer=""
		[[ -z "$answer" ]] && answer=n
	fi
	if [[ "$answer" == [Nn] || -z "$answer" ]]; then
		local name="$suggestion"
		if [[ -z "${ABSORB_FRAGMENT:-}" ]] && : </dev/tty 2>/dev/null; then
			printf 'New fragment name [%s]: ' "$suggestion" >&2
			IFS= read -r frag </dev/tty 2>/dev/null || frag=""
			[[ -n "$frag" ]] && name="$frag"
		fi
		printf '%s\n' "${src}.d/$name"
		return 0
	fi
	if [[ "$answer" =~ ^[0-9]+$ ]] && (( answer >= 1 && answer <= ${#fragments[@]} )); then
		printf '%s\n' "${src}.d/${fragments[answer-1]}"
		return 0
	fi
	case "$answer" in
		*.json|*.yaml|*.yml|*.toml)
			printf '%s\n' "${src}.d/$(basename "$answer")"
			return 0
			;;
		?*)
			printf '%s\n' "${src}.d/$answer.json"
			return 0
			;;
	esac
	printf '%s\n' "${src}.d/$suggestion"
}

# Diff every materialized file in 'selected' against its deployable repo state.
# Managed files compare against a fresh composition; plain copies compare
# directly against their manifest source. MODE 'show' renders one combined
# colored git diff for the whole sweep; 'absorb' reviews each drifted file
# separately, then routes each kept hunk per-hunk to the repo base (default)
# or a machine-local overlay fragment (managed files only).
function absorb_route_kept {
	local idx="$1" src="$2" dst="$3" scratch="$4" picked="$5" difffile="$6" tmp="$7"
	local kind="${drift_kind[idx]}"
	if [[ "$kind" != managed ]]; then
		if git apply "$picked"; then
			return 0
		fi
		error "Some hunks could not be applied to $src; edit it manually (diff saved at $difffile)"
		return 1
	fi
	local base_patch="$tmp/base-$idx" local_patch="$tmp/local-$idx"
	if ! lib/absorb_destinations.py "$base_patch" "$local_patch" < "$picked"; then
		error "Destination routing failed for $src (diff saved at $difffile)"
		return 1
	fi
	local base_n=0 local_n=0
	[[ -s "$base_patch" ]] && base_n=$(grep -c '^@@' "$base_patch" || true)
	[[ -s "$local_patch" ]] && local_n=$(grep -c '^@@' "$local_patch" || true)
	if [[ -s "$base_patch" ]] && ! git apply "$base_patch"; then
		error "Some base hunks could not be applied to $src; edit it manually (diff saved at $difffile)"
		return 1
	fi
	if [[ ! -s "$local_patch" ]]; then
		return 0
	fi
	local desired="$tmp/desired-$idx" baseline2="$tmp/baseline2-$idx" needed="$tmp/needed-$idx.json"
	git -C "$scratch" reset -q
	git -C "$scratch" checkout -- "$src"
	if ! git -C "$scratch" apply "$picked"; then
		error "Could not reconstruct desired state for $src (diff saved at $difffile)"
		return 1
	fi
	cp "$scratch/$src" "$desired"
	local rc=0
	compose_file "$repo_root/$src" "$baseline2" || rc=$?
	if (( rc == 2 )); then
		cp "$repo_root/$src" "$baseline2"
	elif (( rc != 0 )); then
		error "Compose failed for $src; local hunks left unapplied (diff saved at $difffile)"
		return 1
	fi
	local fmt
	fmt="$(absorb_format_for "$src")"
	if ! lib/fragment_extract.py "$baseline2" "$desired" --format "$fmt" > "$needed"; then
		error "Local hunks for $src delete or reorder content, which fragments cannot express; re-run and route them to base (diff saved at $difffile)"
		return 1
	fi
	if [[ -z "$(tr -d '[:space:]' < "$needed")" || "$(tr -d '[:space:]' < "$needed")" == "{}" ]]; then
		message "Local selection for $src is already covered; nothing to write"
		return 0
	fi
	local frag_rel frag_abs
	frag_rel="$(pick_absorb_fragment "$src")"
	frag_abs="$repo_root/$frag_rel"
	mkdir -p "$(dirname "$frag_abs")"
	if [[ -f "$frag_abs" ]]; then
		if ! lib/deep_merge.py "$frag_abs" "$needed"; then
			error "Could not merge local hunks into $frag_rel (needed fragment saved at $needed)"
			return 1
		fi
	else
		cp "$needed" "$frag_abs"
	fi
	message "Absorbed $local_n hunk(s) into $frag_rel ($base_n to base)"
	return 0
}

function run_drift {
	local mode="$1" src dst tmp rc i applied=0 files=0 failed_apply=0

	if (( ${#selected[@]} == 0 )); then
		error "needs at least one config name, e.g. 'me $mode agents'"
		exit 1
	fi

	collect_drift_files verbose
	tmp="$drift_tmp"

	if (( ${#drift_src[@]} == 0 )); then
		rm -rf "$tmp"
		return
	fi

	# Pin identity/hooks/filters so global git config can't block a throwaway commit.
	local git_pin=("-c" "user.name=me.sh drift" "-c" "user.email=noreply@localhost" "-c" "commit.gpgsign=false" "-c" "core.autocrlf=false")

	if [[ "$mode" == show ]]; then
		# One throwaway repo holding every drifted file at its repo path: a
		# single colored git diff covers the whole sweep in one pager session,
		# with a/$src b/$src headers matching the repo layout.
		local scratch="$tmp/repo"
		for (( i=0; i<${#drift_src[@]}; i++ )); do
			mkdir -p "$scratch/$(dirname "${drift_src[i]}")"
			cp "${drift_base[i]}" "$scratch/${drift_src[i]}"
		done
		git -C "$scratch" -c advice.defaultBranchName=false init -q
		git -C "$scratch" "${git_pin[@]}" add -A .
		git -C "$scratch" "${git_pin[@]}" -c core.hooksPath=/dev/null commit -qm base
		for (( i=0; i<${#drift_src[@]}; i++ )); do
			cp "${drift_dst[i]}" "$scratch/${drift_src[i]}"
		done
		message "Drift across ${#drift_src[@]} deployed file(s) (a/ = repo, b/ = live):"
		# Unpinned on purpose: honors your pager (delta, less) and color config.
		git -C "$scratch" diff --color=auto || true
		rm -rf "$tmp"
		return
	fi

	# Phase 2 (absorb): per-file review; each file gets its own scratch repo so
	# accepted hunks are computed and applied independently.
	for (( i=0; i<${#drift_src[@]}; i++ )); do
		src="${drift_src[i]}"
		dst="${drift_dst[i]}"
		local scratch="$tmp/repo-$i"
		mkdir -p "$scratch/$(dirname "$src")"
		cp "${drift_base[i]}" "$scratch/$src"
		git -C "$scratch" -c advice.defaultBranchName=false init -q
		git -C "$scratch" "${git_pin[@]}" add "$src"
		git -C "$scratch" "${git_pin[@]}" -c core.hooksPath=/dev/null commit -qm base
		cp "$dst" "$scratch/$src"

		local difffile="$tmp/diff-$i" picked="$tmp/picked-$i"
		git --no-pager -C "$scratch" diff > "$difffile" || true

		message "Reviewing drift in $src (deployed copy differs from repo):"
		if [[ -z "${ABSORB_ANSWERS:-}" ]] && : </dev/tty 2>/dev/null; then
			git -C "$scratch" add -p "$src" </dev/tty >/dev/tty || true
			git --no-pager -C "$scratch" diff --cached > "$picked" || true
		else
			lib/hunk_selector.py < "$difffile" > "$picked"
		fi
		if [[ -s "$picked" ]]; then
			if absorb_route_kept "$i" "$src" "$dst" "$scratch" "$picked" "$difffile" "$tmp"; then
				(( ++files ))
				applied=$(( applied + $(grep -c '^@@' "$picked" || true) ))
			else
				failed_apply=1
				continue
			fi
		else
			message "Kept nothing; remaining drift stays local in $dst"
		fi
	done

	if (( failed_apply == 0 )); then
		rm -rf "$tmp"
	fi
	if (( files > 0 )); then
		message "Absorbed $applied hunk(s) into $files repo file(s). Re-run your sync to redeploy clean copies."
	fi
}

# Summarize failures and exit with an appropriate status.
function finish {
	if (( ${#failed_units[@]} > 0 )); then
		error "${#failed_units[@]} unit(s) failed:"
		local failed_unit
		for failed_unit in "${failed_units[@]}"; do
			error "  ${failed_unit}"
		done
		exit 1
	fi
	exit 0
}

# --- Validation & dry run -------------------------------------------------

function run_doctor {
	local scope dir base canonical manifest operation src dest marker marker_dest duplicate duplicate_scope
	local failed=0 claims names
	claims="$(mktemp "${TMPDIR:-/tmp}/me-claims.XXXXXX")"
	names="$(mktemp "${TMPDIR:-/tmp}/me-names.XXXXXX")"

	if ! require_yq; then
		failed=1
	fi

	for scope in "$APPS_SCOPE" "$MACOS_SCOPE"; do
		while IFS= read -r dir; do
			base="${dir##*/}"
			if [[ ! -f "$dir/config.yml" ]] && ! find "$dir" -type f -name 'configure_*.sh' | grep -q .; then
				if [[ -e "$dir/post.sh" ]]; then
					error "$dir/post.sh: post.sh belongs only to a manifest unit"
					failed=1
				fi
				continue
			fi
			case "$base" in
				[0-9]* )
					if [[ "$base" != [0-9][0-9]-?* ]]; then
						error "$dir: numeric ordering prefixes must be two digits followed by '-'"
						failed=1
					fi
					;;
			esac
			canonical="$base"
			[[ "$canonical" == [0-9][0-9]-* ]] && canonical="${canonical#??-}"
			printf '%s\t%s\t%s\n' "$scope" "$canonical" "$dir" >> "$names"

			if [[ -f "$dir/config.yml" ]]; then
				manifest="$dir/config.yml"
				if ! validate_manifest_unit "$repo_root/$dir" no no; then
					failed=1
				fi
				if validate_manifest_schema "$manifest" &>/dev/null; then
					for operation in symlinks copies; do
						while IFS=$'\t' read -r src dest; do
							if validate_home_dest "$dest" "$manifest ($src)" &>/dev/null; then
								printf '%s\t%s (%s: %s)\n' "$(expand_dest "$dest")" "$manifest" "$operation" "$src" >> "$claims"
							fi
						done < <(manifest_rows "$manifest" "$operation")
					done
				fi
			elif [[ -e "$dir/post.sh" ]]; then
				error "$dir/post.sh: legacy units may not contain post.sh"
				failed=1
			fi
		done < <(find "configs/$scope" -mindepth 1 -maxdepth 1 -type d | LC_ALL=C sort)
	done

	while IFS= read -r -d '' dir; do
		if [[ ! -f "$dir/dest" ]]; then
			error "$dir: fragment directory is missing its dest marker"
			failed=1
		fi
	done < <(find configs -type d -name '*.d' -print0 | LC_ALL=C sort -z)
	while IFS= read -r -d '' marker; do
		if validate_managed_marker "$repo_root/$marker"; then
			IFS= read -r marker_dest < "$marker"
			printf '%s\t%s\n' "$(expand_dest "$marker_dest")" "$marker" >> "$claims"
		else
			failed=1
		fi
	done < <(find configs -type f -path '*.d/dest' -print0 | LC_ALL=C sort -z)

	while IFS=$'\t' read -r duplicate_scope duplicate; do
		[[ -n "$duplicate" ]] || continue
		error "Duplicate config unit name '$duplicate' in configs/$duplicate_scope:"
		awk -F '\t' -v scope="$duplicate_scope" -v key="$duplicate" '$1 == scope && $2 == key { print "  " $3 }' "$names" >&2
		failed=1
	done < <(awk -F '\t' '{ print $1 "\t" $2 }' "$names" | sort | uniq -d)

	while IFS= read -r duplicate; do
		[[ -n "$duplicate" ]] || continue
		error "Destination is claimed more than once: $duplicate"
		awk -F '\t' -v key="$duplicate" '$1 == key { print "  " $2 }' "$claims" >&2
		failed=1
	done < <(cut -f1 "$claims" | sort | uniq -d)

	rm -f "$claims" "$names"
	if (( failed )); then
		return 1
	fi
	message "All config manifests and managed-file claims are valid."
}

# Write a ~/bin/me shim that execs this checkout's runner with the absolute path
# baked in at install time, so the command survives repo moves without re-editing.
function install_me_shim {
	local shim_dir="$HOME/bin" shim="$HOME/bin/me"
	mkdir -p "$shim_dir"
	{
		printf '#!/bin/bash\n'
		printf '# Installed by me.sh; refresh with "me install".\n'
		printf 'exec %q "$@"\n' "$repo_root/me"
	} > "$shim"
	chmod +x "$shim"
	message "Installed $shim -> $repo_root/me"
	if [[ ":$PATH:" != *":$shim_dir:"* ]]; then
		error "Note: $shim_dir is not on your PATH; it is added by the shell config sync"
	fi
}

function run_plan_selected {
	local unit
	for unit in "${selected[@]}"; do
		if is_manifest_unit "$unit"; then
			message "Planning ${unit}..."
			if ! plan_manifest_unit "$repo_root/$unit"; then
				error "${unit} failed validation"
				failed_units+=("$unit")
			fi
		else
			printf 'run %s (legacy; actions are opaque)\n' "$unit"
		fi
	done
}

