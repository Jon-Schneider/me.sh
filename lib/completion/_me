#compdef me

# Zsh completion for the me.sh 'me' runner.
# Installed into ~/.zsh/completions by configs/apps/shell/configure_shell.sh.

_me() {
	local -a app_names macos_names bootstrap_names scopes
	local scope name runner line

	# Locate the me runner to ask for valid names. Falls back to the
	# canonical checkout location when the repo root is not on PATH.
	runner="$(whence -p me 2>/dev/null)"
	if [[ -z "$runner" ]]; then
		runner="$HOME/Developer/jsc/me.sh/me"
	fi

	while IFS=$'\t' read -r scope name; do
		case "$scope" in
			app) app_names+=("$name") ;;
			macos) macos_names+=("$name") ;;
			bootstrap) bootstrap_names+=("$name") ;;
		esac
	done < <("$runner" --completion-names 2>/dev/null)

	scopes=(
		'all:everything (macOS configs, app configs)'
		'bootstrap:fresh-machine setup steps'
		'app:full app sync'
		'apps:full app sync'
		'mac:full macOS sync'
		'macos:full macOS sync'
		'sys:full macOS sync'
		'system:full macOS sync'
		'absorb:review managed-file drift, keep chosen hunks in the repo'
		'diff:view machine-local drift in managed files'
		'doctor:validate config manifests and destination claims'
		'plan:preview config actions without deploying'
		'up:pick local changes to absorb back into the repo'
	)

	_arguments -C \
		'(-h --help)'{-h,--help}'[show help]' \
		'(-l --list)'{-l,--list}'[list available units]' \
		'1:command-or-scope:->scopes' \
		'*::name:->names'

	case "$state" in
		scopes)
			_describe -t scopes 'scope' scopes
			(( ${#app_names[@]} )) && _describe -t app-names 'app config' app_names
			(( ${#macos_names[@]} )) && _describe -t macos-names 'macOS config' macos_names
			(( ${#bootstrap_names[@]} )) && _describe -t bootstrap-names 'bootstrap unit' bootstrap_names
			;;
		names)
			case "$words[1]" in
				app|apps)
					(( ${#app_names[@]} )) && _describe -t app-names 'app config' app_names
					;;
				mac|macos|sys|system)
					(( ${#macos_names[@]} )) && _describe -t macos-names 'macOS config' macos_names
					;;
				bootstrap)
					(( ${#bootstrap_names[@]} )) && _describe -t bootstrap-names 'bootstrap unit' bootstrap_names
					;;
				all)
					;; # no further arguments
				diff|up|absorb|plan)
					(( ${#app_names[@]} )) && _describe -t app-names 'app config' app_names
					(( ${#macos_names[@]} )) && _describe -t macos-names 'macOS config' macos_names
					;;
				*)
					(( ${#app_names[@]} )) && _describe -t app-names 'app config' app_names
					(( ${#macos_names[@]} )) && _describe -t macos-names 'macOS config' macos_names
					(( ${#bootstrap_names[@]} )) && _describe -t bootstrap-names 'bootstrap unit' bootstrap_names
					;;
			esac
			;;
	esac

	return 0
}

_me "$@"
