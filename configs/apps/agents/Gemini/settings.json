{
  "general": {
    "previewFeatures": true,
    "defaultApprovalMode": "auto_edit"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/bin/set_tmux_agent_status ready"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/bin/set_tmux_agent_status \"\""
          }
        ]
      }
    ],
    "BeforeAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/bin/set_tmux_agent_status running"
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/bin/set_tmux_agent_status ready"
          },
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Submarine.aiff"
          }
        ]
      }
    ],
    "BeforeTool": [
      {
        "matcher": "run_shell_command",
        "hooks": [
          {
            "name": "dcg",
            "type": "command",
            "command": "/Users/jsc/.local/bin/dcg",
            "timeout": 5000
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/bin/set_tmux_agent_status running-tool"
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/bin/set_tmux_agent_status running"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "ActionRequired",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/bin/set_tmux_agent_status needs-input"
          },
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Funk.aiff"
          }
        ]
      }
    ]
  }
}