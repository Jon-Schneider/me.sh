#!/usr/bin/env python3
"""git clean filter: drop herdr's hook registrations from agent config JSON.

`herdr integration install` edits each agent's config in place to register its
session-reporting hook, stamping in an absolute, machine-specific path. Those
edits are herdr's to own and re-apply, so configure_agents.sh installs them
locally and this filter keeps them out of the repo. Reads stdin, writes stdout.

Keys are sorted on the way out. Herdr rewrites these files in sorted order on
every install while the agents themselves write their own order, so without
this the same content churns back and forth depending on who wrote it last.

Shared by every agent whose config is a JSON hooks map (Claude settings.json,
Codex hooks.json); see the .gitattributes beside each one.
"""
import json
import sys

MARKER = "herdr"


def strip_hooks(events):
    kept = {}
    for event, groups in events.items():
        surviving = []
        for group in groups:
            hooks = [h for h in group.get("hooks", []) if MARKER not in h.get("command", "")]
            if not hooks:
                continue
            group["hooks"] = hooks
            surviving.append(group)
        if surviving:
            kept[event] = surviving
    return kept


def clean(text):
    data = json.loads(text)
    if isinstance(data.get("hooks"), dict):
        data["hooks"] = strip_hooks(data["hooks"])
    out = json.dumps(data, indent=2, sort_keys=True)
    return out + "\n" if text.endswith("\n") else out


sys.stdout.write(clean(sys.stdin.read()))
