{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "$HOME/bin/xcsift-for-apple-build-tools",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "$HOME/bin/agent-issue-hook",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "afplay /System/Library/Sounds/Submarine.aiff",
            "type": "command"
          }
        ]
      }
    ]
  }
}
