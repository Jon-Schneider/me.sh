#!/usr/bin/env python3
"""ccusage-window — render `ccusage daily --json --by-agent` (stdin) as a single
ccusage-style table summed over the whole window instead of one row per day,
with per-model breakdown rows inside each agent group.

usage: npx ccusage@latest daily --json --by-agent --since YYYY-MM-DD | ccusage-window "Last 7 Days"
"""
import json
import os
import shutil
import sys

COLOR = (sys.stdout.isatty() or os.environ.get("FORCE_COLOR")) and \
    "NO_COLOR" not in os.environ
BLUE, YELLOW, DIM, RESET = ("\x1b[34m", "\x1b[33m", "\x1b[2m", "\x1b[0m") \
    if COLOR else ("", "", "", "")

NUM_KEYS = ["inputTokens", "outputTokens", "cacheCreationTokens",
            "cacheReadTokens", "totalTokens", "totalCost"]


def comma(n):
    return f"{int(n):,}"


def main():
    label = sys.argv[1] if len(sys.argv) > 1 else "Window"
    data = json.load(sys.stdin)

    def blank():
        return dict.fromkeys(NUM_KEYS, 0) | {"models": {}}

    def add_into(slot, entry):
        for k in NUM_KEYS:
            slot[k] += entry.get(k, 0)
        for m in entry.get("modelBreakdowns", []):
            ms = slot["models"].setdefault(
                m["modelName"], dict.fromkeys(NUM_KEYS, 0))
            ms["inputTokens"] += m.get("inputTokens", 0)
            ms["outputTokens"] += m.get("outputTokens", 0)
            ms["cacheCreationTokens"] += m.get("cacheCreationTokens", 0)
            ms["cacheReadTokens"] += m.get("cacheReadTokens", 0)
            ms["totalCost"] += m.get("cost", 0)

    agents = {}
    for day in data.get("daily", []):
        for a in day.get("agents") or [day]:
            add_into(agents.setdefault(a["agent"], blank()), a)

    all_slot = blank()
    for a in agents.values():
        for k in NUM_KEYS:
            all_slot[k] += a[k]
        for name, m in a["models"].items():
            add_into(all_slot, {"modelBreakdowns": [
                {"modelName": name, "inputTokens": m["inputTokens"],
                 "outputTokens": m["outputTokens"],
                 "cacheCreationTokens": m["cacheCreationTokens"],
                 "cacheReadTokens": m["cacheReadTokens"],
                 "cost": m["totalCost"]}]})

    def fmt_cost(c):
        return f"${c:,.2f}"

    def fmt(e):
        total = e["totalTokens"] or (e["inputTokens"] + e["outputTokens"]
                                    + e["cacheCreationTokens"]
                                    + e["cacheReadTokens"])
        return [comma(e["inputTokens"]), comma(e["outputTokens"]),
                comma(e["cacheCreationTokens"]), comma(e["cacheReadTokens"]),
                comma(total), fmt_cost(e["totalCost"])]

    # Column widths: numbers sized to content; models gets the remainder.
    every = [all_slot, *agents.values()] + \
        [m for a in list(agents.values()) + [all_slot]
         for m in a["models"].values()]
    numw = max(10, max(len(s) for e in every for s in fmt(e)[:-1]))
    costw = max(10, max(len(fmt(e)[-1]) for e in every))
    agentw = max(10, max(len(n) + 2 for n in agents), len("Total"))
    fixed = agentw + 5 * numw + costw + 3 * 8 + 2
    modelw = max(26, shutil.get_terminal_size((160, 40)).columns - fixed)

    def clip(s, w):
        return s if len(s) <= w else s[: w - 1] + "…"

    def row(agent, model, nums, color="", model_dim=False):
        cells = [agent, model] + nums
        widths = [agentw, modelw] + [numw] * 5 + [costw]
        aligns = ["l", "l"] + ["r"] * 6
        parts = [clip(t, w).rjust(w) if a == "r" else clip(t, w).ljust(w)
                 for (t, w, a) in zip(cells, widths, aligns)]
        if model_dim:
            parts = parts[:1] + [f"{DIM}{p}{RESET}" for p in parts[1:]]
        elif color:
            parts = [f"{color}{p}{RESET}" if p.strip() else p
                     for p in parts]
        return "│ " + " │ ".join(parts) + " │"

    def sep(l, m, r):
        return l + m.join("─" * (w + 2) for w in
                          [agentw, modelw] + [numw] * 5 + [costw]) + r

    def entity_rows(name, e):
        out = [row(name, "", fmt(e))]
        for mname in sorted(e["models"], key=lambda n: -e["models"][n]["totalCost"]):
            out.append(row("", "- " + mname, fmt(e["models"][mname]),
                           model_dim=True))
        return out

    detected = ", ".join(sorted(
        {a for d in data.get("daily", [])
          for a in d.get("metadata", {}).get("agents", [])} or set(agents),
        key=str.capitalize))
    title = f"Coding (Agent) CLI Usage Report - {label}"
    subtitle = f"Detected: {detected}" if detected else ""

    inner = max(len(title), len(subtitle)) + 8
    banner = ["╭" + "─" * inner + "╮",
              "│" + " " * inner + "│",
              "│" + f"{BLUE}{title}{RESET}".center(inner + len(BLUE) + len(RESET)) + "│",
              "│" + f"{BLUE}{subtitle}{RESET}".center(inner + len(BLUE) + len(RESET)) + "│",
              "│" + " " * inner + "│",
              "╰" + "─" * inner + "╯"]

    h1 = row("Agent", "Models", ["Input", "Output", "Cache",
             "Cache", "Total", "Cost"])
    h2 = row("", "", ["", "", "Create", "Read", "Tokens", "(USD)"])

    out = ["", *banner, "", sep("┌", "┬", "┐"), h1, h2, sep("├", "┼", "┤")]
    groups = [entity_rows(n.capitalize(), agents[n])
              for n in sorted(agents, key=lambda n: -agents[n]["totalCost"])]
    for g in groups:
        out += g
        out.append(sep("├", "┼", "┤"))
    out.append(row("Total", "", fmt(data["totals"]), YELLOW))
    out.append(sep("└", "┴", "┘"))
    print("\n".join(out))


if __name__ == "__main__":
    main()
