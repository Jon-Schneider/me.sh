#!/usr/bin/env bash
# pt — set the pane title ("pane title") in Herdr. Lets agents label their
# split while working.
#
# Input splits into an optional short title and an optional body:
#
# - -t/--title: short label for the sidebar's first row (next to the
#   workspace name), typically a ticket key like SHP-123.
# - -b/--body: longer text, word-wrapped onto up to two extra agents-list
#   rows (~30 columns each; herdr has no native text wrapping, and rows
#   whose tokens are missing disappear).
#
# Both flags swallow words until the next flag, so quoting is optional:
# `pt -t SHP-123 -b fix the login flow` -> title "SHP-123", body "fix the
# login flow". Bare words (or stdin) are the body: `pt fixed the flaky
# test` just fills the body rows. Use `--` to feed words starting with "-".
#
# The split-pane title itself is "<title> <body>" concatenated.
# Tokens are reported as title_key / title_sum1 / title_sum2 (source me.pt);
# pane-title integrations delegate here, so this is the single writer of
# those tokens.
#
# After every herdr label change this spawns the me.active-tab-title handler
# (symlinked to ~/.config/herdr/active_tab_title_on_event.py), so the tab
# title re-syncs immediately — herdr fires no plugin event for label
# changes. `pt tab` forces that sync without touching the label.
#
# usage: pt [-t <title>] [-b <body>]  set pane title (+ herdr agents-list entry)
#        pt <body>                    bare words are the body
#        pt -c|--clear                clear pane title and agents-list entry
#        pt tab                       re-sync focused tab title now
#        echo <body> | pt             read body from stdin

set -u

TAB_TITLE_SYNC="$HOME/.config/herdr/active_tab_title_on_event.py"

# Detached: never block or fail the title update on the sync.
sync_tab_title() {
  [[ -f "$TAB_TITLE_SYNC" ]] || return 0
  "/usr/bin/python3" "$TAB_TITLE_SYNC" "$@" >/dev/null 2>&1 &
}

case "${1:-}" in
  tab) sync_tab_title; exit 0 ;;
esac

usage() {
  echo "usage: pt [-t <title>] [-b <body>]  set pane title (+ herdr agents-list entry)" >&2
  echo "       pt <body>                    bare words are the body" >&2
  echo "       pt -c|--clear                clear pane title and agents-list entry" >&2
  echo "       echo <body> | pt             read body from stdin" >&2
}

# Collapse whitespace: Herdr titles are single-line.
norm() {
  printf '%s' "$1" | tr '\r\n\t' '   ' | tr -s ' ' | sed 's/^ //; s/ $//'
}

clear=0
title=""
body=""
dest=""   # flag currently collecting words: "" | title | body
while (($#)); do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    -c|--clear) clear=1; shift ;;
    -t|--title) dest=title; shift ;;
    -b|--body) dest=body; shift ;;
    --) shift; break ;;
    -*) echo "pt: unknown option $1" >&2; usage; exit 2 ;;
    *)
      # Words collect into the active flag's value (-t/-b); bare words
      # with no flag seen yet are body shorthand.
      if [[ "$dest" == title ]]; then
        [[ -n "$title" ]] && title="$title $1" || title="$1"
      else
        [[ -n "$body" ]] && body="$body $1" || body="$1"
      fi
      shift ;;
  esac
done

# Anything after -- is body.
if (($#)); then
  if [[ -n "$body" ]]; then
    body="$body $*"
  else
    body="$*"
  fi
elif [[ ! -t 0 && -z "$body" ]]; then
  body="$(cat)"
fi
title="$(norm "$title")"
body="$(norm "$body")"

if ((clear)); then
  title=""
  body=""
elif [[ -z "$title" && -z "$body" ]]; then
  usage
  exit 2
fi

# The split-pane title shows both parts concatenated.
if [[ -n "$title" && -n "$body" ]]; then
  full="$title $body"
else
  full="$title$body"
fi

SIDEBAR_SOURCE="me.pt"
SIDEBAR_KEY="title_key"
SIDEBAR_SUM1="title_sum1"
SIDEBAR_SUM2="title_sum2"

clear_sidebar_tokens() {
  herdr pane report-metadata "${HERDR_PANE_ID}" --source "$SIDEBAR_SOURCE" \
    --clear-token "$SIDEBAR_KEY" \
    --clear-token "$SIDEBAR_SUM1" \
    --clear-token "$SIDEBAR_SUM2" >/dev/null 2>&1 || true
}

report_sidebar_tokens() {
  # Title -> title_key (sidebar row 1); body word-wrapped at word boundaries
  # across up to two ~30-col lines -> title_sum1/title_sum2. Missing pieces
  # get explicit clears, so shrinking titles shrink rows.
  local title="$1" body="$2"
  local wrapped s1 s2
  wrapped="$(printf '%s' "$body" | python3 -c '
import sys

text = " ".join(sys.stdin.read().split())
width = 30
lines, current = [], ""
for word in text.split():
    candidate = f"{current} {word}".strip()
    if current and len(candidate) > width:
        lines.append(current)
        current = word
    else:
        current = candidate
if current:
    lines.append(current)
print("\n".join(lines[:2]))
')" || return 0
  s1="$(printf '%s\n' "$wrapped" | sed -n '1p')"
  s2="$(printf '%s\n' "$wrapped" | sed -n '2p')"

  local args=(pane report-metadata "${HERDR_PANE_ID}" --source "$SIDEBAR_SOURCE")
  if [[ -n "$title" ]]; then
    args+=(--token "${SIDEBAR_KEY}=${title}")
  else
    args+=(--clear-token "$SIDEBAR_KEY")
  fi
  if [[ -n "$s1" ]]; then
    args+=(--token "${SIDEBAR_SUM1}=${s1}")
  else
    args+=(--clear-token "$SIDEBAR_SUM1")
  fi
  if [[ -n "$s2" ]]; then
    args+=(--token "${SIDEBAR_SUM2}=${s2}")
  else
    args+=(--clear-token "$SIDEBAR_SUM2")
  fi
  herdr "${args[@]}" >/dev/null 2>&1 || true
}

if [[ "${HERDR_ENV:-}" == "1" && -n "${HERDR_SOCKET_PATH:-}" && -n "${HERDR_PANE_ID:-}" ]]; then
  if ((clear)); then
    herdr pane rename "${HERDR_PANE_ID}" --clear >/dev/null 2>&1 || true
    clear_sidebar_tokens
    sync_tab_title "${HERDR_PANE_ID}"
    exit 0
  fi
  herdr pane rename "${HERDR_PANE_ID}" "$full" >/dev/null 2>&1 || true
  report_sidebar_tokens "$title" "$body"
  sync_tab_title "${HERDR_PANE_ID}"
  exit 0
fi

echo "pt: not running inside Herdr" >&2
exit 1
