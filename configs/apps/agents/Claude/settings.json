{
  "agentPushNotifEnabled": true,
  "effortLevel": "medium",
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true
  },
  "env": {
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false"
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "afplay /System/Library/Sounds/Funk.aiff",
            "type": "command"
          }
        ],
        "matcher": "permission_prompt"
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "afplay /System/Library/Sounds/Funk.aiff",
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "/Users/$(whoami)/.local/bin/dcg",
            "type": "command"
          },
          {
            "command": "/Users/$(whoami)/bin/xcsift-for-apple-build-tools",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "/Users/$(whoami)/bin/agent-issue-hook",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "afplay /System/Library/Sounds/Submarine.aiff",
            "type": "command"
          }
        ]
      }
    ]
  },
  "model": "opus",
  "permissions": {
    "allow": [
      "Bash(diff:*)",
      "Bash(git diff:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(wc:*)",
      "Edit(~/**/*)",
      "Write(~/**/*)"
    ],
    "deny": [
      "Bash(swiftformat:*)",
      "Read(~/.ssh/*)"
    ]
  },
  "skipDangerousModePermissionPrompt": true,
  "statusLine": {
    "command": "bash /Users/$(whoami)/.claude/statusline-command.sh",
    "type": "command"
  },
  "tui": "fullscreen"
}
