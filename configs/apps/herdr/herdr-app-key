#!/usr/bin/python3
"""Route app-aware shortcuts through the running session's socket API."""

import os
import sys

from herdr_api import api


def main():
    if len(sys.argv) != 2 or sys.argv[1] not in {"save", "copy", "up", "down", "left", "right"}:
        print("usage: herdr-app-key save|copy|up|down|left|right", file=sys.stderr)
        return 64
    action = sys.argv[1]
    pane = os.environ["HERDR_ACTIVE_PANE_ID"]
    info = api("pane.process_info", pane_id=pane)["process_info"]
    apps = {process.get("name") for process in info.get("foreground_processes", [])}

    if action in {"save", "copy"}:
        # Editors own Ctrl+S/C; Codex owns Ctrl+C for its selected text.
        # Shells receive neither: these would freeze or interrupt them.
        if apps & {"micro", "xlent"}:
            api("pane.send_keys", pane_id=pane, keys=["ctrl+" + action[0]])
        elif action == "copy" and "codex" in apps:
            api("pane.send_keys", pane_id=pane, keys=["ctrl+c"])
        elif action == "save":
            api("plugin.action.invoke", action_id="jhochenbaum.hunkdiff.send-review",
                plugin_id="jhochenbaum.hunkdiff")
    elif "xlent" in apps:
        api("pane.send_keys", pane_id=pane, keys=["shift+" + action])
    elif action in {"left", "right"}:
        api("plugin.action.invoke", action_id="move-" + action, plugin_id="me.space-mover")
    else:
        workspaces = api("workspace.list")["workspaces"]
        current = next((i for i, workspace in enumerate(workspaces) if workspace.get("focused")), None)
        if current is not None:
            step = -1 if action == "up" else 1
            target = workspaces[(current + step) % len(workspaces)]["workspace_id"]
            api("workspace.focus", workspace_id=target)
    return 0


if __name__ == "__main__":
    sys.exit(main())
