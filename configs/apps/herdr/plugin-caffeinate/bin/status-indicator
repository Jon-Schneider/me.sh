#!/bin/sh
set -u

# Herdr tab-bar commands are ordinary commands, not plugin invocations, so no
# HERDR_PLUGIN_STATE_DIR is in the environment. Default to where Herdr puts it
# and accept an explicit root as the first argument.
STATE_ROOT=${1:-${HERDR_PLUGIN_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/herdr/plugins/me.caffeinate}}
[ -n "$STATE_ROOT" ] || exit 0

for state_file in "$STATE_ROOT"/sessions/*/assertion-state; do
    [ -f "$state_file" ] || continue
    [ "$(cat "$state_file" 2>/dev/null || true)" = awake ] || continue

    session_dir=${state_file%/*}
    pid_file="$session_dir/caffeinate.pid"
    [ -f "$pid_file" ] || continue
    pid=$(cat "$pid_file" 2>/dev/null || true)
    case "$pid" in
        ''|*[!0-9]*) continue ;;
    esac
    kill -0 "$pid" 2>/dev/null || continue
    process_state=$(ps -p "$pid" -o state= 2>/dev/null || true)
    case "$process_state" in
        ''|*Z*) continue ;;
    esac

    command=$(ps -p "$pid" -o command= 2>/dev/null || true)
    case "$command" in
        *caffeinate*"-i"*)
            printf '☕\n'
            exit 0
            ;;
    esac
done

exit 0
