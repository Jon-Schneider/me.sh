#!/usr/bin/env python3
"""Step through every Herdr tab in sidebar workspace order."""

from __future__ import annotations

import os
import sys


def workspace_display_order(workspaces: list[dict]) -> list[dict]:
    """Match Herdr's expanded sidebar worktree-tree projection.

    The workspace API returns raw storage order. The sidebar groups workspaces
    with the same repo key when the group contains a parent checkout: the
    parent is displayed first, followed by linked worktrees in storage order.
    The complete group is emitted where its first raw member occurred.
    """
    members_by_key: dict[str, list[dict]] = {}
    for workspace in workspaces:
        worktree = workspace.get("worktree") or {}
        repo_key = worktree.get("repo_key")
        if isinstance(repo_key, str):
            members_by_key.setdefault(repo_key, []).append(workspace)

    grouped_keys = {
        repo_key
        for repo_key, members in members_by_key.items()
        if len(members) >= 2
        and any(
            not (member.get("worktree") or {}).get("is_linked_worktree")
            for member in members
        )
    }

    emitted: set[str] = set()
    ordered: list[dict] = []
    for workspace in workspaces:
        worktree = workspace.get("worktree") or {}
        repo_key = worktree.get("repo_key")
        if repo_key not in grouped_keys:
            ordered.append(workspace)
            continue
        if repo_key in emitted:
            continue

        emitted.add(repo_key)
        members = members_by_key[repo_key]
        parent = next(
            member
            for member in members
            if not (member.get("worktree") or {}).get("is_linked_worktree")
        )
        ordered.append(parent)
        ordered.extend(member for member in members if member is not parent)

    return ordered


def tab_sequence(workspaces: list[dict], tabs: list[dict]) -> list[str]:
    tabs_by_workspace: dict[str, list[str]] = {}
    for tab in tabs:
        workspace_id = tab.get("workspace_id")
        tab_id = tab.get("tab_id")
        if isinstance(workspace_id, str) and isinstance(tab_id, str):
            tabs_by_workspace.setdefault(workspace_id, []).append(tab_id)

    sequence: list[str] = []
    for workspace in workspace_display_order(workspaces):
        workspace_id = workspace.get("workspace_id")
        if isinstance(workspace_id, str):
            sequence.extend(tabs_by_workspace.get(workspace_id, []))
    return sequence


def focused_tab(workspaces: list[dict], tabs: list[dict]) -> str | None:
    active_tab = os.environ.get("HERDR_ACTIVE_TAB_ID")
    if active_tab:
        return active_tab
    return next(
        (
            tab["tab_id"]
            for tab in tabs
            if tab.get("focused") and isinstance(tab.get("tab_id"), str)
        ),
        None,
    ) or next(
        (
            workspace["active_tab_id"]
            for workspace in workspaces
            if workspace.get("focused")
            and isinstance(workspace.get("active_tab_id"), str)
        ),
        None,
    )


def main() -> int:
    from herdr_api import api

    if len(sys.argv) < 2 or sys.argv[1] not in {"next", "previous"}:
        print("usage: herdr-tab-step next|previous [--dry-run]", file=sys.stderr)
        return 64
    operation = sys.argv[1]
    dry_run = "--dry-run" in sys.argv[2:]

    workspaces = api("workspace.list").get("workspaces", [])
    tabs = api("tab.list").get("tabs", [])
    sequence = tab_sequence(workspaces, tabs)
    current = focused_tab(workspaces, tabs)
    if not current:
        print("herdr-tab-step: Herdr has no focused tab", file=sys.stderr)
        return 1
    if current not in sequence:
        print("herdr-tab-step: focused tab missing from walk order", file=sys.stderr)
        return 1
    if len(sequence) < 2:
        return 0

    offset = -1 if operation == "previous" else 1
    target = sequence[(sequence.index(current) + offset) % len(sequence)]
    if dry_run:
        print(target)
        return 0

    api("tab.focus", tab_id=target)
    return 0


if __name__ == "__main__":
    sys.exit(main())
