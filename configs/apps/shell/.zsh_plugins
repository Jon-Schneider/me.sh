# Load oh-my-zsh deps for OMZ plugins
getantidote/use-omz
ohmyzsh/ohmyzsh path:lib

# Load after OMZ's libraries so autocomplete owns the final key bindings, but
# before plugins such as OMZ Git call compdef.
marlonrichert/zsh-autocomplete branch:fe6c658

ohmyzsh/ohmyzsh path:plugins/git

# Syntax highlighting must load after plugins that create ZLE widgets.
zsh-users/zsh-syntax-highlighting
