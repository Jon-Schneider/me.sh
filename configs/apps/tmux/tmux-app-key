#!/usr/bin/env python3
"""Send a key to micro (or another named app) in the current tmux pane, otherwise run a fallback.

Extra apps are checked with repeated `--app <process-name> <key>` arguments;
micro takes priority, then apps in the order given, then the fallback.
"""

from __future__ import annotations

import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path


PROCESS_RE = re.compile(r"^[^TXZ ]+\s+(.+?)\s*$")
MICRO_RAW_KEYS = {
    "MicroDeleteStart": "\x1bmicro-delete-start",
    "MicroStartOfLine": "\x1bmicro-start-of-line",
    "MicroSelectStart": "\x1bmicro-select-start",
    "MicroSelectEnd": "\x1bmicro-select-end",
    "MicroCut": "\x1bmicro-cut",
    "MicroCopy": "\x1bmicro-copy",
    "MicroSelectLeft": "\x1bmicro-select-left",
    "MicroSelectRight": "\x1bmicro-select-right",
    "MicroSelectWordLeft": "\x1bmicro-select-word-left",
    "MicroSelectWordRight": "\x1bmicro-select-word-right",
}
HERDR_ACTIONS = {
    "HerdrNewWorkspace": ("workspace", "create"),
    "HerdrNewTab": ("tab", "create"),
    "HerdrCloseTab": ("tab", "close"),
    "HerdrCloseWorkspace": ("workspace", "close"),
    "HerdrPreviousWorkspace": ("workspace", "previous"),
    "HerdrNextWorkspace": ("workspace", "next"),
    "HerdrPreviousTab": ("tab", "previous"),
    "HerdrNextTab": ("tab", "next"),
}
# Shift+Left/Right rearrange spaces when Herdr owns the pane. tmux eats the
# raw keys before Herdr sees them, so these invoke the me.space-mover plugin
# actions (the same ones [keys.command] binds to Shift+Left/Right standalone).
HERDR_SPACE_MOVES = {
    "HerdrMoveSpaceLeft": "move-left",
    "HerdrMoveSpaceRight": "move-right",
}
HERDR_PANE_DIRECTIONS = {
    "HerdrFocusPaneLeft": ("focus", "left"),
    "HerdrFocusPaneRight": ("focus", "right"),
    "HerdrFocusPaneUp": ("focus", "up"),
    "HerdrFocusPaneDown": ("focus", "down"),
    "HerdrSwapPaneLeft": ("swap", "left"),
    "HerdrSwapPaneRight": ("swap", "right"),
    "HerdrSwapPaneUp": ("swap", "up"),
    "HerdrSwapPaneDown": ("swap", "down"),
}
HERDR_SPLITS = {
    "HerdrSplitRight": ("right", True),
    "HerdrSplitRightNoFocus": ("right", False),
    "HerdrSplitDown": ("down", True),
    "HerdrSplitDownNoFocus": ("down", False),
}


def run(argv: list[str]) -> subprocess.CompletedProcess[str]:
    return subprocess.run(argv, capture_output=True, text=True, check=False)


def usage() -> int:
    print(
        "usage: tmux-app-key <pane-id> (<micro-key> | --no-micro) "
        "[--app <process-name> <key>]... "
        "[-- <fallback tmux command...> | --exec <fallback command...>]",
        file=sys.stderr,
    )
    return 64


def current_pane(tmux: str, arg: str | None) -> str | None:
    if arg and not arg.startswith("#{"):
        return arg
    if os.environ.get("TMUX_PANE"):
        return os.environ["TMUX_PANE"]

    pane = run([tmux, "display-message", "-p", "#{pane_id}"])
    if pane.returncode != 0:
        return None
    return pane.stdout.strip() or None


def pane_tty(tmux: str, target: str) -> str | None:
    tty = run([tmux, "display-message", "-p", "-t", target, "#{pane_tty}"])
    if tty.returncode != 0:
        return None
    return tty.stdout.strip() or None


def process_names_for_tty(tty: str) -> list[str] | None:
    try:
        ps = subprocess.run(
            ["ps", "-t", tty, "-o", "state=", "-o", "comm="],
            capture_output=True,
            text=True,
            check=False,
        )
    except OSError as error:
        print(f"tmux-app-key: failed to run ps: {error}", file=sys.stderr)
        return None

    if ps.returncode != 0:
        return []

    names: list[str] = []
    for line in ps.stdout.splitlines():
        match = PROCESS_RE.match(line)
        if not match:
            continue
        names.append(Path(match.group(1)).name.lower())
    return names


def pane_process_names(tmux: str, target: str) -> list[str] | None:
    tty = pane_tty(tmux, target)
    if not tty:
        return []
    return process_names_for_tty(tty)


def focused_herdr_resource(
    herdr: str, resource: str
) -> tuple[dict[str, object], list[dict[str, object]]] | None:
    result = run([herdr, resource, "list"])
    if result.returncode != 0:
        print(result.stderr.strip() or result.stdout.strip(), file=sys.stderr)
        return None

    try:
        payload = json.loads(result.stdout)
    except json.JSONDecodeError as error:
        print(f"tmux-app-key: invalid Herdr response: {error}", file=sys.stderr)
        return None

    resources = payload.get("result", {}).get(f"{resource}s", [])
    focused = next((item for item in resources if item.get("focused")), None)
    if not focused:
        print(f"tmux-app-key: Herdr has no focused {resource}", file=sys.stderr)
        return None
    return focused, resources


def herdr_binary() -> str | None:
    herdr = shutil.which("herdr")
    if not herdr:
        print("tmux-app-key: herdr not found", file=sys.stderr)
    return herdr


def run_herdr_split(app_key: str) -> int:
    direction, focus = HERDR_SPLITS[app_key]

    herdr = herdr_binary()
    if not herdr:
        return 127

    # No target pane: Herdr splits its own focused pane, which is the one the
    # tmux pane is showing. The me.even-panes plugin evens the tab out right
    # after the split.
    result = run(
        [
            herdr,
            "pane",
            "split",
            "--direction",
            direction,
            "--focus" if focus else "--no-focus",
        ]
    )
    if result.returncode != 0:
        print(result.stderr.strip() or result.stdout.strip(), file=sys.stderr)
    return result.returncode


def run_herdr_pane_direction(app_key: str) -> int:
    operation, direction = HERDR_PANE_DIRECTIONS[app_key]

    herdr = herdr_binary()
    if not herdr:
        return 127

    # No target pane: Herdr acts on its own focused pane, which is the one the
    # tmux pane is showing. At a layout edge this is a no-op, not an error.
    result = run([herdr, "pane", operation, "--direction", direction])
    if result.returncode != 0:
        print(result.stderr.strip() or result.stdout.strip(), file=sys.stderr)
    return result.returncode


def focused_split_pane_id(herdr: str, tab_id: str) -> str | None:
    """Focused pane id when its tab holds more than one pane, otherwise None."""
    result = run([herdr, "pane", "list"])
    if result.returncode != 0:
        print(result.stderr.strip() or result.stdout.strip(), file=sys.stderr)
        return None

    try:
        payload = json.loads(result.stdout)
    except json.JSONDecodeError as error:
        print(f"tmux-app-key: invalid Herdr response: {error}", file=sys.stderr)
        return None

    panes = [
        pane
        for pane in payload.get("result", {}).get("panes", [])
        if pane.get("tab_id") == tab_id
    ]
    if len(panes) < 2:
        return None

    focused = next((pane for pane in panes if pane.get("focused")), None)
    pane_id = focused.get("pane_id") if focused else None
    return pane_id if isinstance(pane_id, str) else None


def ordered_herdr_tab_sequence(herdr: str) -> list[str]:
    """Every Herdr tab id in stable order: workspaces by number, tabs by number."""
    workspaces_result = run([herdr, "workspace", "list"])
    if workspaces_result.returncode != 0:
        print(
            workspaces_result.stderr.strip() or workspaces_result.stdout.strip(),
            file=sys.stderr,
        )
        return []
    tabs_result = run([herdr, "tab", "list"])
    if tabs_result.returncode != 0:
        print(tabs_result.stderr.strip() or tabs_result.stdout.strip(), file=sys.stderr)
        return []

    try:
        workspaces = json.loads(workspaces_result.stdout)["result"]["workspaces"]
        tabs = json.loads(tabs_result.stdout)["result"]["tabs"]
    except (json.JSONDecodeError, KeyError) as error:
        print(f"tmux-app-key: invalid Herdr response: {error}", file=sys.stderr)
        return []

    tabs_by_workspace: dict[str, list[dict[str, object]]] = {}
    for tab in tabs:
        workspace_id = tab.get("workspace_id")
        if isinstance(workspace_id, str):
            tabs_by_workspace.setdefault(workspace_id, []).append(tab)

    sequence: list[str] = []
    for workspace in sorted(workspaces, key=lambda item: item.get("number") or 0):
        workspace_id = workspace.get("workspace_id")
        if not isinstance(workspace_id, str):
            continue
        workspace_tabs = sorted(
            tabs_by_workspace.get(workspace_id, []),
            key=lambda item: item.get("number") or 0,
        )
        sequence.extend(
            tab_id
            for tab in workspace_tabs
            if isinstance((tab_id := tab.get("tab_id")), str)
        )
    return sequence


def run_herdr_space_move(app_key: str) -> int:
    herdr = herdr_binary()
    if not herdr:
        return 127

    result = run(
        [
            herdr,
            "plugin",
            "action",
            "invoke",
            HERDR_SPACE_MOVES[app_key],
            "--plugin",
            "me.space-mover",
        ]
    )
    if result.returncode != 0:
        print(result.stderr.strip() or result.stdout.strip(), file=sys.stderr)
    return result.returncode


def run_herdr_action(app_key: str) -> int:
    action = HERDR_ACTIONS.get(app_key)
    if not action:
        return 64

    herdr = herdr_binary()
    if not herdr:
        return 127

    resource, operation = action
    command = [herdr, resource, operation]
    if operation == "create":
        command.append("--focus")
    else:
        focused_result = focused_herdr_resource(herdr, resource)
        if not focused_result:
            return 1
        focused_resource, resources = focused_result
        resource_id = focused_resource.get(f"{resource}_id")
        if not isinstance(resource_id, str):
            print(f"tmux-app-key: Herdr returned no {resource} id", file=sys.stderr)
            return 1

        if operation in {"previous", "next"}:
            if resource == "tab":
                # Tab navigation walks all Herdr tabs in workspace order rather
                # than wrapping inside one workspace: moving past a workspace's
                # last tab lands on the next workspace's first tab (and
                # symmetrically backwards). Past the very first/last Herdr tab
                # it hands off to the previous/next tmux window instead of
                # wrapping. Standalone Herdr (running outside tmux) never
                # reaches this script and keeps its own wrap-around behavior.
                sequence = ordered_herdr_tab_sequence(herdr)
                if not sequence:
                    return 1
                current_tab_id = focused_resource.get("tab_id")
                if not isinstance(current_tab_id, str) or current_tab_id not in sequence:
                    print(
                        "tmux-app-key: focused Herdr tab missing from tab sequence",
                        file=sys.stderr,
                    )
                    return 1
                offset = -1 if operation == "previous" else 1
                target_index = sequence.index(current_tab_id) + offset
                if not 0 <= target_index < len(sequence):
                    tmux = shutil.which("tmux")
                    if tmux:
                        run(
                            [
                                tmux,
                                "previous-window"
                                if operation == "previous"
                                else "next-window",
                            ]
                        )
                        # Already past the first/last tmux window too (e.g. a
                        # single window): previous/next-window exits non-zero.
                        # That is a boundary no-op here, not an error -- a
                        # non-zero exit makes tmux's run-shell raise its
                        # "'...' returned N" error overlay over the terminal.
                        return 0
                    # No tmux binary: degrade to the old wrap-around.
                    target_index %= len(sequence)
                command = [herdr, "tab", "focus", sequence[target_index]]
            else:
                navigation_resources = resources
                if len(navigation_resources) == 1:
                    return 0
                focused_index = navigation_resources.index(focused_resource)
                offset = -1 if operation == "previous" else 1
                target_resource = navigation_resources[
                    (focused_index + offset) % len(navigation_resources)
                ]
                target_id = target_resource.get(f"{resource}_id")
                if not isinstance(target_id, str):
                    print(
                        f"tmux-app-key: Herdr returned no {resource} id",
                        file=sys.stderr,
                    )
                    return 1
                command = [herdr, resource, "focus", target_id]
        elif resource == "tab":
            split_pane_id = focused_split_pane_id(herdr, resource_id)
            workspace_id = focused_resource.get("workspace_id")
            workspace_tab_count = sum(
                item.get("workspace_id") == workspace_id for item in resources
            )
            if split_pane_id:
                # Close the focused split first; the tab only closes once it is
                # down to a single pane.
                command = [herdr, "pane", "close", split_pane_id]
            # Herdr refuses to close a workspace's final tab. Match macOS Cmd+W
            # behavior by closing that workspace instead.
            elif isinstance(workspace_id, str) and workspace_tab_count == 1:
                command = [herdr, "workspace", "close", workspace_id]
            else:
                command.append(resource_id)
        else:
            command.append(resource_id)

    result = run(command)
    if result.returncode != 0:
        print(result.stderr.strip() or result.stdout.strip(), file=sys.stderr)
    return result.returncode


def main() -> int:
    args = sys.argv[1:]
    if not args or args[0] in {"-h", "--help"}:
        return usage()

    tmux = shutil.which("tmux")
    if not tmux:
        print("tmux-app-key: tmux not found", file=sys.stderr)
        return 127

    target = current_pane(tmux, args.pop(0))
    if not target or not args:
        return usage()

    micro_key = None if args[:1] == ["--no-micro"] else args[0]
    args.pop(0)

    app_keys: list[tuple[str, str]] = []
    while args[:1] == ["--app"]:
        if len(args) < 3:
            return usage()
        args.pop(0)
        app_keys.append((args.pop(0).lower(), args.pop(0)))

    fallback_is_external = args[:1] == ["--exec"]
    if args[:1] in (["--"], ["--exec"]):
        args.pop(0)

    names = pane_process_names(tmux, target)
    if names is None:
        return 1

    if micro_key and "micro" in names:
        if micro_key in MICRO_RAW_KEYS:
            return subprocess.run(
                [tmux, "send-keys", "-t", target, "-l", MICRO_RAW_KEYS[micro_key]],
                check=False,
            ).returncode
        return subprocess.run([tmux, "send-keys", "-t", target, micro_key], check=False).returncode

    for app_name, app_key in app_keys:
        if app_name in names:
            if app_name == "herdr":
                if app_key in HERDR_SPLITS:
                    return run_herdr_split(app_key)
                if app_key in HERDR_PANE_DIRECTIONS:
                    return run_herdr_pane_direction(app_key)
                if app_key in HERDR_SPACE_MOVES:
                    return run_herdr_space_move(app_key)
                if app_key in HERDR_ACTIONS:
                    return run_herdr_action(app_key)
            return subprocess.run(
                [tmux, "send-keys", "-t", target, app_key], check=False
            ).returncode

    if args:
        if fallback_is_external:
            return subprocess.run(args, check=False).returncode
        return subprocess.run([tmux, *args], check=False).returncode
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
