#!/usr/bin/env python3
"""Dispatch tmux copied text through an agent-specific cleaner.

Machine-specific agents go in ~/.config/me.sh/agent-cleaners.json (or $AGENT_CLEANERS_MANIFEST),
a JSON object of process name → cleaner name or path, which overlays the built-in map.
"""

from __future__ import annotations

import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path


BUILTIN_AGENT_CLEANERS = {
    "claude": "clean-claude-copy",
    "codex": "clean-codex-copy",
    "gemini": "clean-gemini-copy",
}
LOCAL_MANIFEST_ENV = "AGENT_CLEANERS_MANIFEST"
DEFAULT_LOCAL_MANIFEST = Path.home() / ".config/me.sh/agent-cleaners.json"
PROCESS_RE = re.compile(r"^[^TXZ ]+\s+(.+?)\s*$")


def local_manifest_path() -> Path:
    override = os.environ.get(LOCAL_MANIFEST_ENV)
    return Path(override).expanduser() if override else DEFAULT_LOCAL_MANIFEST


def agent_cleaners() -> dict[str, str]:
    """Built-in process-name → cleaner map, overlaid with an uncommitted local manifest."""
    cleaners = dict(BUILTIN_AGENT_CLEANERS)
    manifest = local_manifest_path()
    try:
        entries = json.loads(manifest.read_text())
    except FileNotFoundError:
        return cleaners
    except (OSError, json.JSONDecodeError) as error:
        sys.stderr.write(f"clean-agent-copy: ignoring {manifest}: {error}\n")
        return cleaners

    if not isinstance(entries, dict):
        sys.stderr.write(f"clean-agent-copy: ignoring {manifest}: expected a JSON object\n")
        return cleaners

    for process_name, cleaner in entries.items():
        if isinstance(cleaner, str) and cleaner:
            cleaners[str(process_name).lower()] = cleaner
    return cleaners


def run(argv: list[str]) -> subprocess.CompletedProcess[str]:
    return subprocess.run(argv, capture_output=True, text=True, check=False)


def current_pane() -> str | None:
    if len(sys.argv) > 1 and sys.argv[1] and not sys.argv[1].startswith("#{"):
        return sys.argv[1]
    if os.environ.get("TMUX_PANE"):
        return os.environ["TMUX_PANE"]

    tmux = shutil.which("tmux")
    if not tmux:
        return None

    pane = run([tmux, "display-message", "-p", "#{pane_id}"])
    if pane.returncode != 0:
        return None
    return pane.stdout.strip() or None


def pane_tty(target: str) -> str | None:
    tmux = shutil.which("tmux")
    if not tmux:
        return None

    tty = run([tmux, "display-message", "-p", "-t", target, "#{pane_tty}"])
    if tty.returncode != 0:
        return None
    return tty.stdout.strip() or None


def process_names_for_tty(tty: str) -> list[str]:
    ps = run(["ps", "-t", tty, "-o", "state=", "-o", "comm="])
    if ps.returncode != 0:
        return []

    names: list[str] = []
    for line in ps.stdout.splitlines():
        match = PROCESS_RE.match(line)
        if not match:
            continue
        names.append(Path(match.group(1)).name.lower())
    return names


def detect_agent(target: str | None, cleaners: dict[str, str]) -> str | None:
    if not target:
        return None

    tty = pane_tty(target)
    if not tty:
        return None

    for name in process_names_for_tty(tty):
        if name in cleaners:
            return name
    return None


def resolve_cleaner(cleaner_name: str) -> str:
    if "/" in cleaner_name:
        return str(Path(cleaner_name).expanduser())
    sibling_cleaner = Path(__file__).with_name(cleaner_name)
    return str(sibling_cleaner) if sibling_cleaner.exists() else cleaner_name


def clean_with(cleaner_name: str, text: str) -> int:
    cleaner = resolve_cleaner(cleaner_name)
    try:
        proc = subprocess.run([cleaner], input=text, capture_output=True, text=True, check=False)
    except FileNotFoundError:
        sys.stdout.write(text)
        return 0
    sys.stdout.write(proc.stdout)
    sys.stderr.write(proc.stderr)
    return proc.returncode


def main() -> int:
    text = sys.stdin.read()
    cleaners = agent_cleaners()
    agent = detect_agent(current_pane(), cleaners)

    if agent:
        return clean_with(cleaners[agent], text)

    sys.stdout.write(text)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
