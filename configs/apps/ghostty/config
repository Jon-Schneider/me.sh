# This is the configuration file for Ghostty.
#
# This template file has been automatically created at the following
# path since Ghostty couldn't find any existing config files on your system:
#
#   /Users/jsc/Library/Application Support/com.mitchellh.ghostty/config
#
# The template does not set any default options, since Ghostty ships
# with sensible defaults for all options. Users should only need to set
# options that they want to change from the default.
#
# Run `ghostty +show-config --default --docs` to view a list of
# all available config options and their default values.
#
# Additionally, each config option is also explained in detail
# on Ghostty's website, at https://ghostty.org/docs/config.
#
# Ghostty can reload the configuration while running by using the menu
# options or the bound key (default: Command + Shift + comma on macOS and
# Control + Shift + comma on other platforms). Not all config options can be
# reloaded while running; some only apply to new windows and others may require
# a full restart to take effect.

# Config syntax crash course
# ==========================
# # The config file consists of simple key-value pairs,
# # separated by equals signs.
# font-family = Iosevka
# window-padding-x = 2
#
# # Spacing around the equals sign does not matter.
# # All of these are identical:
# key=value
# key= value
# key =value
# key = value
#
# # Any line beginning with a # is a comment. It's not possible to put
# # a comment after a config option, since it would be interpreted as a
# # part of the value. For example, this will have a value of "#123abc":
# background = #123abc
#
# # Empty values are used to reset config keys to default.
# key =
#
# # Some config options have unique syntaxes for their value,
# # which is explained in the docs for that config option.
# # Just for example:
# resize-overlay-duration = 4s 200ms

theme = jon
copy-on-select = clipboard

# Herdr owns these chords directly. Unbind Ghostty's actions so the negotiated
# keyboard protocol forwards actual key events, including their modifiers.
# Injecting Ctrl-Space + a printable letter can strand Herdr in prefix mode
# when the pane enables Kitty report-all keyboard input.
# Option-splits keep focus on the original pane.
keybind = super+enter=unbind
keybind = super+alt+enter=unbind
keybind = super+shift+enter=unbind
keybind = super+shift+alt+enter=unbind
# Cmd+Z reaches Herdr directly: the me.active-tab-title plugin's zoom-toggle
# action wraps pane.zoom with an in-process tab-title resync, so the ⛶
# marker in the tab bar tracks every press (bare pane.zoom --toggle is
# silent when the focused pane is unchanged).
keybind = cmd+d=unbind
keybind = cmd+z=unbind
keybind = cmd+r=unbind
keybind = cmd+shift+r=unbind
keybind = cmd+shift+x=unbind
keybind = cmd+shift+f=unbind
# Move the focused pane sideways through its project's tabs and spaces;
# crossing the project's first/last edge creates a space before/after.
# Up/Down still swap with the neighboring pane.
keybind = ctrl+shift+left=unbind
keybind = ctrl+shift+right=unbind
keybind = ctrl+shift+up=unbind
keybind = ctrl+shift+down=unbind
# Cmd+Shift+arrows focus the neighboring pane.
keybind = super+shift+left=unbind
keybind = super+shift+right=unbind
keybind = super+shift+up=unbind
keybind = super+shift+down=unbind
# Route macOS window-management chords through Herdr so it can manage spaces
# and tabs while other panes retain their existing behavior.
#   Cmd+S -> ~/bin/herdr-app-key save (xlent/micro), else
#           hunkdiff send-review (the pre-router Cmd+S behavior)
#   Cmd+C -> ~/bin/herdr-app-key copy (xlent/micro/Codex),
#            else no-op in shells
#   Cmd+X -> Herdr's native new-worktree binding (kept; cut in
#           xlent is its native Ctrl+X)
#   Cmd+V stays Ghostty's native paste (bracketed paste reaches xlent)
keybind = super+w=text:\x17
keybind = super+s=unbind
keybind = super+x=unbind
keybind = super+c=unbind
keybind = super+n=unbind
keybind = super+t=unbind
keybind = super+q=unbind
# Modified Tab did not reach Herdr reliably when its Ghostty action was unbound.
# Send one explicit Kitty key report for each direct Herdr chord.
keybind = ctrl+tab=csi:9;5u
keybind = ctrl+shift+tab=csi:9;6u
# Cmd+Shift+L toggles Herdr's sidebar directly.
keybind = super+shift+l=unbind

# xlent bold/italic: Cmd+B sends Ctrl+B straight through to the pane. Cmd+I
# sends Ctrl+I, which in terminal byte encoding is identical to Tab.
keybind = cmd+b=text:\x02
keybind = cmd+i=text:\x09

# Disable toggling fullscreen
keybind = super+ctrl+f=unbind

# Home/End pass straight through (like Cmd+Right below); sending Ctrl-Space+B
# here made Herdr standalone toggle the sidebar instead.
keybind = cmd+left=text:\x1b[H
keybind = cmd+right=text:\x1b[F
# Karabiner consumes Cmd+Ctrl+Arrow before AppKit can emit NSBeep and sends
# these otherwise-unused function keys instead.
keybind = f13=unbind
keybind = f14=unbind
keybind = f15=unbind
keybind = f16=unbind
# Cmd+Backspace clears the line: send Ctrl+U straight through so shells get
# kill-whole-line. Sending Ctrl-Space+D here would invoke Herdr's
# close_workspace command.
keybind = cmd+backspace=text:\x15

# Enable Shift + Enter going to new line in 'git commit -m "..."'
keybind = shift+enter=text:\n

# Play Codex approval notifications emitted as terminal bells.
bell-features = audio
bell-audio-path = /System/Library/Sounds/Funk.aiff
